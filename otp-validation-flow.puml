@startuml
title OTP Validation Flow

actor Client
participant "ReccedaOtp" as RO
participant "ReccedaOtpStore" as Store
participant "Caffeine Cache" as Cache
participant "SHA-256 Hasher" as Hash

Client -> RO: verifyOtp(key, otp)
activate RO

RO -> Store: verifyOtp(key, otp)
activate Store

Store -> Cache: getIfPresent(key)
activate Cache

alt Entry Not Found
    Cache -> Store: null
    deactivate Cache
    Store -> RO: false
    deactivate Store
    RO -> Client: false
    deactivate RO
else Entry Found
    Cache -> Store: OtpEntry
    deactivate Cache
    
    Store -> Hash: hashOtp(otp)
    activate Hash
    Hash -> Hash: SHA-256 digest
    Hash -> Store: hashedOtp
    deactivate Hash
    
    alt Hash Matches
        Store -> RO: true
        deactivate Store
        RO -> Client: true
        deactivate RO
    else Hash Doesn't Match
        Store -> Store: entry.failedAttempts++
        Store -> Cache: put(key, updatedEntry)
        activate Cache
        Cache -> Store: stored
        deactivate Cache
        Store -> RO: false
        deactivate Store
        RO -> Client: false
        deactivate RO
    end
end

@enduml