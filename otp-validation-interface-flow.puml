@startuml
title OTP Validation Flow - Interface Level

actor Client
participant "ReccedaOtp" as RO
participant "OtpStore" as Store

Client -> RO: verifyOtp(key, otp)
activate RO

RO -> Store: verifyOtp(key, otp)
activate Store

Store -> Store: retrieve entry for key
alt Entry Not Found
    Store -> RO: false
    deactivate Store
    RO -> Client: false
    deactivate RO
else Entry Found
    Store -> Store: hash input OTP
    Store -> Store: compare with stored hash
    
    alt Hash Matches
        Store -> RO: true
        deactivate Store
        RO -> Client: true
        deactivate RO
    else Hash Doesn't Match
        Store -> Store: increment failed attempts
        Store -> RO: false
        deactivate Store
        RO -> Client: false
        deactivate RO
    end
end

@enduml